<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="GlassBilling.Views.BillingPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:GlassBilling.ViewModels"
    xmlns:controls="clr-namespace:GlassBilling.Views.Controls"
    Title="{Binding Title}"
    Background="{StaticResource AppBackgroundBrush}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="BillingEntry" TargetType="Entry" BasedOn="{StaticResource FormEntry}">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="Margin" Value="0" />
            </Style>
            <Style x:Key="BillingPicker" TargetType="Picker" BasedOn="{StaticResource FormPicker}">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="Margin" Value="0" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid Padding="24,0">
        <ScrollView HorizontalOptions="Fill" VerticalOptions="Fill">
            <VerticalStackLayout Padding="0" Spacing="16" MaximumWidthRequest="1200" HorizontalOptions="Center" WidthRequest="-1">

                <Frame BackgroundColor="White" CornerRadius="12" Padding="16" HasShadow="True">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Bill Details"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />

                        <Label Text="Select Customer" Style="{StaticResource FormLabel}" />
                        <Picker ItemsSource="{Binding Customers}"
                            ItemDisplayBinding="{Binding DisplayName}"
                            SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                            Style="{StaticResource BillingPicker}"
                            TextColor="{StaticResource TextPrimary}"
                            SelectedIndexChanged="OnCustomerPickerSelectionChanged" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="Number of Thickness Types" Style="{StaticResource FormLabel}" />
                                <Entry Text="{Binding NumberOfThicknessTypes, Mode=TwoWay}"
                                       Keyboard="Numeric"
                                       Placeholder="1"
                                       Style="{StaticResource BillingEntry}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="Apply"
                                    Style="{StaticResource OutlineButton}"
                                    HeightRequest="44"
                                    WidthRequest="90"
                                    VerticalOptions="End"
                                    Clicked="OnApplyThicknessClicked"
                                    Command="{Binding RebuildBillItemEntriesCommand}" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding BillItemEntries}" Spacing="14">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:BillItemEntry">
                            <Frame BackgroundColor="White" CornerRadius="12" Padding="14" HasShadow="True">
                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="4">
                                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                            <Label Text="Glass Type" Style="{StaticResource FormLabel}" />
                                            <Picker ItemsSource="{Binding AvailableGlassTypes}"
                                                    SelectedItem="{Binding GlassDescription, Mode=TwoWay}"
                                                    Style="{StaticResource BillingPicker}"
                                                    TextColor="{StaticResource TextPrimary}"
                                                    SelectedIndexChanged="OnAnySelectionChanged" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="2">
                                            <Label Text="Thickness Type" Style="{StaticResource FormLabel}" />
                                            <Picker ItemsSource="{Binding AvailableTypes}"
                                                    ItemDisplayBinding="{Binding Name}"
                                                    SelectedItem="{Binding ThicknessType, Mode=TwoWay}"
                                                    Style="{StaticResource BillingPicker}"
                                                    SelectedIndexChanged="OnAnySelectionChanged"
                                                    TextColor="{StaticResource TextPrimary}" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="2">
                                            <Label Text="Unit" Style="{StaticResource FormLabel}" />
                                            <Picker SelectedItem="{Binding MeasurementUnit, Mode=TwoWay}"
                                                    Style="{StaticResource BillingPicker}"
                                                    SelectedIndexChanged="OnAnySelectionChanged"
                                                    TextColor="{StaticResource TextPrimary}">
                                                <Picker.ItemsSource>
                                                    <x:Array Type="{x:Type x:String}">
                                                        <x:String>mm</x:String>
                                                        <x:String>cm</x:String>
                                                        <x:String>inch</x:String>
                                                        <x:String>feet</x:String>
                                                    </x:Array>
                                                </Picker.ItemsSource>
                                            </Picker>
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="2">
                                            <Label Text="Item Rate (per sq ft)" Style="{StaticResource FormLabel}" />
                                            <Entry Text="{Binding Rate, Mode=TwoWay}"
                                                   Keyboard="Numeric"
                                                   HorizontalTextAlignment="End"
                                                   HorizontalOptions="Fill"
                                                   Style="{StaticResource BillingEntry}"
                                                   TextChanged="OnAnyValueChanged" />
                                        </VerticalStackLayout>
                                    </Grid>

                                    <!-- <Grid ColumnDefinitions="32,*,*,70,42"
                                          BackgroundColor="{StaticResource PrimaryColor}"
                                          Padding="4,7">
                                        <Label Grid.Column="0" Text="#" FontAttributes="Bold" FontSize="11" HorizontalOptions="Center" TextColor="White" />
                                        <Label Grid.Column="1" Text="Height" FontAttributes="Bold" FontSize="11" HorizontalOptions="Center" TextColor="White" />
                                        <Label Grid.Column="2" Text="Width" FontAttributes="Bold" FontSize="11" HorizontalOptions="Center" TextColor="White" />
                                        <Label Grid.Column="3" Text="Qty" FontAttributes="Bold" FontSize="11" HorizontalOptions="Center" TextColor="White" />
                                    </Grid> -->

                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rows}" Spacing="2">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:MeasurementEntryRow">
                                                <Grid ColumnDefinitions="Auto,2*,2*,3*,*,Auto" Padding="2,3" ColumnSpacing="4">
                                                    <Label Grid.Column="0"
                                                           Text="{Binding RowNumber}"
                                                           FontSize="12"
                                                           TextColor="{StaticResource TextSecondary}"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center" />
                                                       <Entry Grid.Column="1"
                                                           Text="{Binding Length, Mode=TwoWay}"
                                                           Keyboard="Numeric"
                                                           Placeholder="Length"
                                                           Style="{StaticResource BillingEntry}"
                                                           TextChanged="OnAnyValueChanged" />
                                                       <Entry Grid.Column="2"
                                                           Text="{Binding Width, Mode=TwoWay}"
                                                           Keyboard="Numeric"
                                                           Placeholder="Width"
                                                           Style="{StaticResource BillingEntry}"
                                                           TextChanged="OnAnyValueChanged" />
                                                    <Picker Grid.Column="3"
                                                            ItemsSource="{Binding AvailableShapes}"
                                                            SelectedItem="{Binding Shape, Mode=TwoWay}"
                                                            AutomationProperties.Name="Shape"
                                                            Style="{StaticResource BillingPicker}"
                                                            HeightRequest="44"
                                                            FontSize="13"
                                                            TextColor="{StaticResource TextPrimary}"
                                                            SelectedIndexChanged="OnAnySelectionChanged" />
                                                       <Entry Grid.Column="4"
                                                           Text="{Binding Quantity, Mode=TwoWay}"
                                                           Keyboard="Numeric"
                                                           Style="{StaticResource BillingEntry}"
                                                           TextChanged="OnAnyValueChanged" />
                                                    <Button Grid.Column="5"
                                                            Text="X"
                                                            BackgroundColor="Transparent"
                                                            TextColor="#E53935"
                                                            FontAttributes="Bold"
                                                            Padding="0"
                                                            CommandParameter="{Binding .}"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NewBillViewModel}}, Path=RemoveRowCommand}" />
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>

                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <Button Grid.Column="0"
                                                Text="+ Add Row"
                                                Style="{StaticResource OutlineButton}"
                                                CommandParameter="{Binding .}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NewBillViewModel}}, Path=AddRowToEntryCommand}" />
                                        <Button Grid.Column="1"
                                                Text="Remove Last Row"
                                                BackgroundColor="#FCE4EC"
                                                TextColor="#E53935"
                                                CornerRadius="8"
                                                CommandParameter="{Binding .}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NewBillViewModel}}, Path=RemoveLastRowFromEntryCommand}" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Frame BackgroundColor="White" CornerRadius="8" Padding="8" HasShadow="True">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Extra Charges"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />

                        <Grid BindableLayout.ItemsSource="{Binding ExtraCharges}"
                              ColumnDefinitions="*,*,*,*"
                              RowDefinitions="Auto,Auto,Auto,Auto"
                              ColumnSpacing="8"
                              RowSpacing="10"
                              HorizontalOptions="Fill">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:ExtraChargeEntry">
                                    <Border Grid.Row="{Binding RowIndex}"
                                            Grid.Column="{Binding ColumnIndex}"
                                            Stroke="#E5E7EB"
                                            StrokeThickness="1"
                                            BackgroundColor="#F8FAFC"
                                            StrokeShape="RoundRectangle 8"
                                            Padding="8,6"
                                            HorizontalOptions="Fill">
                                        <Grid ColumnDefinitions="*,80" ColumnSpacing="6" HeightRequest="44">
                                            <Entry Grid.Column="0"
                                                   Text="{Binding Name, Mode=TwoWay}"
                                                   Placeholder="Name"
                                                   FontSize="12"
                                                   TextColor="{StaticResource TextPrimary}"
                                                   PlaceholderColor="{StaticResource TextSecondary}"
                                                   BackgroundColor="White"
                                                   HeightRequest="32"
                                                   Margin="0" />

                                            <Entry Grid.Column="1"
                                                   Text="{Binding Amount, Mode=TwoWay}"
                                                   Keyboard="Numeric"
                                                   Placeholder="0"
                                                   FontSize="12"
                                                   TextColor="{StaticResource TextPrimary}"
                                                   PlaceholderColor="{StaticResource TextSecondary}"
                                                   BackgroundColor="White"
                                                   HeightRequest="32"
                                                   Margin="0"
                                                   HorizontalTextAlignment="End"
                                                   TextChanged="OnAnyValueChanged" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </Grid>

                        <Button Text="+ Add Extra Charge"
                                Style="{StaticResource OutlineButton}"
                                HeightRequest="34"
                                Command="{Binding AddExtraChargeCommand}" />
                    </VerticalStackLayout>
                </Frame>

                <Frame BackgroundColor="White" CornerRadius="12" Padding="16" HasShadow="True">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,170" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="Tax / GST (%)" Style="{StaticResource FormLabel}" />
                                <Label Text="Applied to subtotal , Extra charges are inclusive of tax"
                                       FontSize="11"
                                       TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <Entry Grid.Column="1"
                                   Text="{Binding TaxPercent, Mode=TwoWay}"
                                   Keyboard="Numeric"
                                   HorizontalTextAlignment="End"
                                   Style="{StaticResource BillingEntry}"
                                   TextChanged="OnAnyValueChanged" />
                        </Grid>

                        <Grid ColumnDefinitions="*,170" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="Discount" Style="{StaticResource FormLabel}" />
                                <Label Text="Amount to be discounted from total"
                                       FontSize="11"
                                       TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <Entry Grid.Column="1"
                                   x:Name="DiscountEntry"
                                   Text="{Binding DiscountAmount, Mode=TwoWay}"
                                   Keyboard="Numeric"
                                   HorizontalTextAlignment="End"
                                   Style="{StaticResource BillingEntry}"
                                   TextChanged="OnDiscountValueChanged" />
                        </Grid>

                        <Label Text="Notes" Style="{StaticResource FormLabel}" />
                        <Editor Text="{Binding Notes, Mode=TwoWay}"
                            Placeholder="Any notes for this invoice..."
                            HeightRequest="76"
                            FontSize="13"
                            TextColor="{StaticResource TextPrimary}"
                            BackgroundColor="White" />
                    </VerticalStackLayout>
                </Frame>

                <Frame BackgroundColor="White"
                       CornerRadius="12"
                       Padding="16"
                       HasShadow="True"
                       BorderColor="{StaticResource PrimaryColor}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Sub Total" FontSize="13" TextColor="{StaticResource TextPrimary}" />
                            <Label Grid.Column="1" x:Name="SubTotalLbl" FontSize="13" TextColor="{StaticResource TextPrimary}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Extra Charges" FontSize="13" TextColor="{StaticResource TextPrimary}" />
                            <Label Grid.Column="1" x:Name="ExtraTotalLbl" FontSize="13" TextColor="{StaticResource TextPrimary}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label x:Name="TaxLbl" FontSize="13" TextColor="{StaticResource TextPrimary}" />
                            <Label Grid.Column="1" x:Name="TaxAmtLbl" FontSize="13" TextColor="{StaticResource TextPrimary}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Discount" FontSize="13" TextColor="{StaticResource TextPrimary}" />
                            <Label Grid.Column="1" x:Name="DiscountAmtLbl" FontSize="13" TextColor="{StaticResource TextPrimary}" />
                        </Grid>
                        <BoxView HeightRequest="1.5" BackgroundColor="{StaticResource PrimaryColor}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Grand Total" FontAttributes="Bold" FontSize="17" TextColor="{StaticResource PrimaryColor}" />
                            <Label Grid.Column="1" x:Name="GrandTotalLbl" FontAttributes="Bold" FontSize="17" TextColor="{StaticResource PrimaryColor}" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <Grid Padding="0,8,0,12" HorizontalOptions="Center">
                        <Button Text="Preview"
                            Style="{StaticResource PrimaryButton}"
                            Padding="24,0"
                            MinimumWidthRequest="180"
                            MaximumWidthRequest="260"
                            WidthRequest="200"
                            HorizontalOptions="Center"
                            Clicked="OnPreviewBillClicked" />
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

        <Grid BackgroundColor="#80000000" IsVisible="{Binding IsCustomerFormVisible}">
            <controls:CustomerFormView
                Title="Add Customer"
                NameText="{Binding NewCustomerName}"
                LocationText="{Binding NewCustomerLocation}"
                PhoneText="{Binding NewCustomerPhone}"
                AddressText="{Binding NewCustomerAddress}"
                SaveCommand="{Binding SaveCustomerFromFormCommand}"
                CancelCommand="{Binding CancelCustomerFormCommand}"
                HorizontalOptions="Fill"
                VerticalOptions="Center" />
        </Grid>

        <Grid BackgroundColor="#CC000000"
              x:Name="LoadingOverlay" IsVisible="False">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                <ActivityIndicator IsRunning="True" Color="White" HeightRequest="50" />
                  <Label Text="Preparing preview..." TextColor="White"
                       FontSize="16" FontAttributes="Bold" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
