<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="GlassBilling.Views.CustomersPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:GlassBilling.ViewModels"
    xmlns:models="clr-namespace:GlassBilling.Models"
    xmlns:controls="clr-namespace:GlassBilling.Views.Controls"
    Title="Customers"
    Background="{StaticResource AppBackgroundBrush}">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Search bar -->
        <SearchBar
            Grid.Row="0"
            Placeholder="Search customers..."
            Text="{Binding SearchText}"
            Margin="12,8" />

        <!-- Add button -->
        <Button
            Grid.Row="1"
            Text="+ Add Customer"
            Style="{StaticResource PrimaryButton}"
            Command="{Binding NewCustomerCommand}"
            Margin="12,0,12,8" />

        <!-- List -->
        <CollectionView
            Grid.Row="2"
            ItemsSource="{Binding Customers}"
            Margin="12,0,12,12">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Customer">
                    <Border Padding="14"
                            Margin="0,0,0,10"
                            Stroke="{StaticResource BorderColor}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            Background="White">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                                <Label Text="{Binding Name}"
                                       FontAttributes="Bold"
                                       FontSize="15"
                                       TextColor="{StaticResource TextPrimary}" />
                                <Label Text="{Binding Location}"
                                       FontSize="13"
                                       TextColor="{StaticResource TextSecondary}" />
                                <Label Text="{Binding Phone}"
                                       FontSize="12"
                                       TextColor="{StaticResource TextSecondary}" />
                                <Label Text="{Binding Address}"
                                       FontSize="12"
                                       TextColor="{StaticResource TextSecondary}"
                                       LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                            <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                <Button Grid.Column="0"
                                        Text="Edit"
                                        Style="{StaticResource OutlineButton}"
                                        HeightRequest="38"
                                        Padding="12,0"
                                        CommandParameter="{Binding .}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CustomersViewModel}}, Path=EditCustomerCommand}" />
                                <Button Grid.Column="1"
                                        Text="Delete"
                                        Style="{StaticResource DangerButton}"
                                        HeightRequest="38"
                                        Padding="10,0"
                                        CommandParameter="{Binding .}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CustomersViewModel}}, Path=DeleteCustomerCommand}" />
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Margin="0,60">
                    <Label Text="No customers yet" FontSize="16" TextColor="#9E9E9E" HorizontalOptions="Center" />
                    <Label Text='Tap "+ Add Customer" to get started' FontSize="13" TextColor="#BDBDBD" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- Edit overlay -->
        <Grid
            Grid.RowSpan="3"
            BackgroundColor="#80000000"
            IsVisible="{Binding IsEditing}">
            <controls:CustomerFormView
                Title="Customer Details"
                NameText="{Binding Name}"
                LocationText="{Binding Location}"
                PhoneText="{Binding Phone}"
                AddressText="{Binding Address}"
                CancelCommand="{Binding CancelEditCommand}"
                SaveCommand="{Binding SaveCustomerCommand}" />
        </Grid>

        <!-- Loading -->
        <ActivityIndicator
            Grid.RowSpan="3"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            Color="{StaticResource PrimaryColor}"
            HorizontalOptions="Center"
            VerticalOptions="Center" />

    </Grid>
</ContentPage>
