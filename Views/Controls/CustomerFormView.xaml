<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="GlassBilling.Views.Controls.CustomerFormView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root">
    <Frame
        BackgroundColor="White"
        CornerRadius="16"
        Padding="20"
        Margin="20"
        VerticalOptions="Center">
        <VerticalStackLayout Spacing="6">
            <Label Text="{Binding Source={x:Reference Root}, Path=Title}"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}" />

            <Label Text="Name *" Style="{StaticResource FormLabel}" />
            <Entry Text="{Binding Source={x:Reference Root}, Path=NameText}"
                   Placeholder="Full name"
                   Style="{StaticResource FormEntry}" />

            <Label Text="Location / Area" Style="{StaticResource FormLabel}" />
            <Entry Text="{Binding Source={x:Reference Root}, Path=LocationText}"
                   Placeholder="e.g. Kongad"
                   Style="{StaticResource FormEntry}" />

            <Label Text="Phone" Style="{StaticResource FormLabel}" />
            <Entry Text="{Binding Source={x:Reference Root}, Path=PhoneText}"
                   Placeholder="+91 XXXXX XXXXX"
                   Keyboard="Telephone"
                   Style="{StaticResource FormEntry}" />

            <Label Text="Address" Style="{StaticResource FormLabel}" />
            <Editor Text="{Binding Source={x:Reference Root}, Path=AddressText}"
                    Placeholder="Full address"
                    HeightRequest="80"
                    BackgroundColor="White" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,10,0,0">
                <Button Grid.Column="0"
                        Text="Cancel"
                        Style="{StaticResource OutlineButton}"
                        Command="{Binding Source={x:Reference Root}, Path=CancelCommand}" />
                <Button Grid.Column="1"
                        Text="Save"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding Source={x:Reference Root}, Path=SaveCommand}" />
            </Grid>
        </VerticalStackLayout>
    </Frame>
</ContentView>
