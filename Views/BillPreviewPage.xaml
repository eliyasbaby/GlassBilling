<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="GlassBilling.Views.BillPreviewPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Invoice Preview"
    BackgroundColor="#F4F4F4">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="PDF" Clicked="OnGeneratePdfClicked" />
        <ToolbarItem Text="Share" Clicked="OnShareClicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0" Orientation="Both">
            <VerticalStackLayout Padding="20" HorizontalOptions="Center">
                <Border
                    BackgroundColor="White"
                    Stroke="#DDDDDD"
                    StrokeThickness="1"
                    Padding="0"
                    HorizontalOptions="Center"
                    MaximumWidthRequest="920"
                    Margin="8,0">
                    <VerticalStackLayout x:Name="InvoiceRoot" Padding="18,20,18,16" Spacing="10">
                        <Grid ColumnDefinitions="170,*" Padding="0,0,0,10">
                            <Image
                                Source="glasslogo.png"
                                HeightRequest="90"
                                WidthRequest="160"
                                Aspect="AspectFit"
                                HorizontalOptions="End"
                                VerticalOptions="Center" />

                            <VerticalStackLayout Grid.Column="1" Spacing="2" Padding="16,0,20,0">
                                <Label
                                    x:Name="CompanyLabel"
                                    FontAttributes="Bold"
                                    FontSize="33"
                                    TextColor="#17436E"
                                    HorizontalTextAlignment="Center"
                                    LineBreakMode="TailTruncation" />
                                <Label
                                    x:Name="CompanyAddressLabel"
                                    FontSize="16"
                                    TextColor="Black"
                                    HorizontalTextAlignment="Center"
                                    LineBreakMode="WordWrap" />
                                <Label
                                    x:Name="CompanyPhoneLabel"
                                    FontSize="16"
                                    TextColor="Black"
                                    HorizontalTextAlignment="Center" />
                                <Label
                                    x:Name="CompanyEmailLabel"
                                    FontSize="16"
                                    TextColor="Black"
                                    HorizontalTextAlignment="Center" />
                                <Label
                                    x:Name="CompanyGstinLabel"
                                    FontSize="16"
                                    TextColor="Black"
                                    HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#9A9A9A" Margin="0,0,0,0" />

                        <Grid ColumnDefinitions="*,*" Padding="0,8,0,10">
                            <VerticalStackLayout Spacing="1" Padding="0,0,8,0">
                                <Label Text="Customer Details" FontAttributes="Bold" FontSize="16" TextColor="Black" />
                                <Label x:Name="CustomerNameLabel" FontSize="16" TextColor="Black" />
                                <Label x:Name="CustomerLocationLabel" FontSize="16" TextColor="Black" />
                                <Label x:Name="CustomerPhoneLabel" FontSize="16" TextColor="Black" />
                                <Label Text="Email:" FontSize="16" TextColor="Black" />
                                <Label Text="GST No:" FontSize="16" TextColor="Black" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="1" Padding="18,0,0,0">
                                <Label x:Name="BillDateLabel" FontSize="16" TextColor="Black" />
                                <Label x:Name="BillNumberLabel" FontSize="16" TextColor="Black" />
                                <Label x:Name="OfficePhoneLabel" FontSize="16" TextColor="Black" />
                                <Label x:Name="CompanyEmailValueLabel" FontSize="16" TextColor="Black" />
                                <Label x:Name="CompanyGstinValueLabel" FontSize="16" TextColor="Black" />
                                <Label Text="Salesman:" FontSize="16" TextColor="Black" />
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#9A9A9A" />

                        <Label
                            Text="PROFORMA INVOICE"
                            FontAttributes="Bold"
                            FontSize="24"
                            TextColor="Black"
                            TextDecorations="Underline"
                            HorizontalTextAlignment="Center"
                            Margin="0,8,0,8" />

                        <BoxView HeightRequest="1" Color="#9A9A9A" />

                        <VerticalStackLayout x:Name="TableContainer" Spacing="0" />

                        <Grid ColumnDefinitions="280,1,210,1,*" Padding="0,14,0,0">
                            <VerticalStackLayout Grid.Column="0" Spacing="0">
                                <VerticalStackLayout x:Name="BankLayout" Spacing="1" />
                                <Label
                                    Text="Terms and Conditions"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    TextColor="Black"
                                    Margin="0,18,0,0" />
                                <Label
                                    x:Name="TermsLabel"
                                    FontSize="12"
                                    TextColor="Black"
                                    LineBreakMode="WordWrap" />
                            </VerticalStackLayout>

                            <Image
                                Grid.Column="2"
                                Source="upi.jpeg"
                                WidthRequest="180"
                                HeightRequest="180"
                                Aspect="AspectFit"
                                HorizontalOptions="Center"
                                VerticalOptions="Start" />

                            <VerticalStackLayout Grid.Column="4" Spacing="18" Padding="0,12,0,0">
                                <VerticalStackLayout x:Name="ExtraChargesLayout" Spacing="8" />
                                <VerticalStackLayout x:Name="TotalsLayout" Spacing="8" />
                            </VerticalStackLayout>
                        </Grid>

                        <Frame x:Name="NotesFrame" BackgroundColor="White" BorderColor="#9A9A9A"
                               CornerRadius="0" Padding="10" IsVisible="False" Margin="0,12,0,0">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Notes:" FontAttributes="Bold" FontSize="12" TextColor="Black" />
                                <Label x:Name="NotesLabel" FontSize="12" TextColor="Black" />
                            </VerticalStackLayout>
                        </Frame>

                        <BoxView HeightRequest="1" Color="#9A9A9A" Margin="0,10,0,0" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="10" Padding="12,8" BackgroundColor="#F4F4F4">
            <Button Grid.Column="0" Text="Generate PDF"
                    Style="{StaticResource PrimaryButton}"
                    Clicked="OnGeneratePdfClicked" />
            <Button Grid.Column="1" Text="Share"
                    Style="{StaticResource OutlineButton}"
                    Clicked="OnShareClicked" />
        </Grid>

        <Grid Grid.RowSpan="2" BackgroundColor="#CC000000"
              x:Name="LoadingOverlay" IsVisible="False">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                <ActivityIndicator IsRunning="True" Color="White" HeightRequest="50" />
                <Label Text="Generating PDF..." TextColor="White"
                       FontSize="16" FontAttributes="Bold" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
