<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="GlassBilling.Views.BillHistoryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:GlassBilling.ViewModels"
    xmlns:models="clr-namespace:GlassBilling.Models"
    Title="Bill History">

    <Grid RowDefinitions="Auto,*">

        <SearchBar
            Grid.Row="0"
            Placeholder="Search by bill number or customer..."
            Text="{Binding SearchText}"
            Margin="12,8" />

        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Bills}"
            Margin="8,0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Bill">
                    <Frame Padding="10"
                           Margin="0,3"
                           CornerRadius="10"
                           HasShadow="False"
                           BorderColor="{StaticResource BorderColor}"
                           BackgroundColor="White">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="{Binding BillNumber}"
                                       FontAttributes="Bold"
                                       FontSize="14"
                                       TextColor="{StaticResource PrimaryColor}" />
                                <Label Text="{Binding Customer.Name}"
                                       FontSize="13"
                                       TextColor="{StaticResource TextPrimary}" />
                                <Label Text="{Binding Customer.Location}"
                                       FontSize="11"
                                       TextColor="{StaticResource TextSecondary}" />
                                <Label Text="{Binding FormattedDate}"
                                       FontSize="11"
                                       TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="6" HorizontalOptions="End">
                                <Label Text="{Binding FormattedTotal}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource PrimaryColor}"
                                       HorizontalOptions="End" />

                                <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="6">
                                    <Button Grid.Column="0"
                                            Text="View"
                                            Style="{StaticResource PrimaryButton}"
                                            HeightRequest="30"
                                            Padding="10,0"
                                            FontSize="11"
                                            CommandParameter="{Binding .}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BillHistoryViewModel}}, Path=ViewBillCommand}" />
                                    <Button Grid.Column="1"
                                            Text="Edit"
                                            Style="{StaticResource OutlineButton}"
                                            HeightRequest="30"
                                            Padding="10,0"
                                            FontSize="11"
                                            CommandParameter="{Binding .}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BillHistoryViewModel}}, Path=EditBillCommand}" />
                                    <Button Grid.Column="2"
                                            Text="Delete"
                                            Style="{StaticResource DangerButton}"
                                            HeightRequest="30"
                                            Padding="10,0"
                                            FontSize="11"
                                            CommandParameter="{Binding .}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BillHistoryViewModel}}, Path=DeleteBillCommand}" />
                                </Grid>
                            </VerticalStackLayout>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Margin="0,80">
                    <Label Text="No bills yet" FontSize="16" TextColor="#9E9E9E" HorizontalOptions="Center" />
                    <Label Text="Create a new bill from the home screen" FontSize="13" TextColor="#BDBDBD" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

        <ActivityIndicator
            Grid.RowSpan="2"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            Color="{StaticResource PrimaryColor}"
            HorizontalOptions="Center"
            VerticalOptions="Center" />
    </Grid>
</ContentPage>
