<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="GlassBilling.Views.BillHistoryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:GlassBilling.ViewModels"
    xmlns:models="clr-namespace:GlassBilling.Models"
    Title="Bill History"
    Background="{StaticResource AppBackgroundBrush}">

    <Grid RowDefinitions="Auto,*,Auto">

        <SearchBar
            Grid.Row="0"
            Placeholder="Search by bill number or customer..."
            Text="{Binding SearchText}"
            Margin="12,8" />

        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Bills}"
            Margin="12,0,12,8">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Bill">
                      <Border Padding="14"
                        Margin="0,0,0,10"
                        Stroke="{StaticResource BorderColor}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        Background="White">
                       <Grid RowDefinitions="Auto,1,Auto"
                          ColumnDefinitions="*,Auto"
                          ColumnSpacing="12"
                          RowSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                                <Label Text="{Binding BillNumber}"
                                       FontAttributes="Bold"
                                FontSize="15"
                                       TextColor="{StaticResource PrimaryColor}" />
                                <Label Text="{Binding Customer.Name}"
                                       FontSize="13"
                                       TextColor="{StaticResource TextPrimary}" />
                                <Label Text="{Binding Customer.Location}"
                                       FontSize="11"
                                       TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="End" VerticalOptions="Center">
                            <Label Text="{Binding FormattedTotal}"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="{StaticResource PrimaryColor}"
                                HorizontalOptions="End" />
                            <Label Text="{Binding FormattedDate}"
                                FontSize="11"
                                TextColor="{StaticResource TextSecondary}"
                                HorizontalOptions="End" />
                                <Label Text="{Binding ConfirmationStatus}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                TextColor="#B45309"
                                HorizontalOptions="End">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsConfirmed}" Value="True">
                                            <Setter Property="TextColor" Value="{StaticResource SuccessColor}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </VerticalStackLayout>

                            <BoxView Grid.Row="1"
                                     Grid.ColumnSpan="2"
                                     HeightRequest="1"
                                     BackgroundColor="{StaticResource BorderColor}" />

                            <FlexLayout Grid.Row="2"
                                        Grid.ColumnSpan="2"
                                        Direction="Row"
                                        Wrap="Wrap"
                                        JustifyContent="End"
                                        AlignItems="Center">
                                <Button Text="Mark Confirmed"
                                        Style="{StaticResource OutlineButton}"
                                        HeightRequest="36"
                                        Padding="10,0"
                                        FontSize="11"
                                        Margin="0,0,6,0"
                                        CommandParameter="{Binding .}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BillHistoryViewModel}}, Path=ToggleConfirmationCommand}">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsConfirmed}" Value="True">
                                            <Setter Property="Text" Value="Mark as Quote" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                                <Button Text="View"
                                        Style="{StaticResource PrimaryButton}"
                                        HeightRequest="36"
                                        Padding="12,0"
                                        FontSize="11"
                                        Margin="0,0,6,0"
                                        CommandParameter="{Binding .}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BillHistoryViewModel}}, Path=ViewBillCommand}" />
                                <Button Text="Edit"
                                        Style="{StaticResource OutlineButton}"
                                        HeightRequest="36"
                                        Padding="12,0"
                                        FontSize="11"
                                        Margin="0,0,6,0"
                                        CommandParameter="{Binding .}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BillHistoryViewModel}}, Path=EditBillCommand}" />
                                <Button Text="Delete"
                                        Style="{StaticResource DangerButton}"
                                        HeightRequest="36"
                                        Padding="12,0"
                                        FontSize="11"
                                        CommandParameter="{Binding .}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BillHistoryViewModel}}, Path=DeleteBillCommand}" />
                            </FlexLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Margin="0,80">
                    <Label Text="No bills yet" FontSize="16" TextColor="#9E9E9E" HorizontalOptions="Center" />
                    <Label Text="Create a new bill from the home screen" FontSize="13" TextColor="#BDBDBD" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

          <Grid Grid.Row="2"
              ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="12"
              Padding="12,8">
            <Button Grid.Column="0"
                    Text="Previous"
                    Style="{StaticResource OutlineButton}"
                    TextColor="White"
                    BorderColor="White"
                    HeightRequest="40"
                    IsEnabled="{Binding CanGoPrevious}"
                    Command="{Binding PreviousPageCommand}" />
            <Label Grid.Column="1"
                   Text="{Binding PageStatus}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   TextColor="White" />
            <Button Grid.Column="2"
                    Text="Next"
                    Style="{StaticResource OutlineButton}"
                    TextColor="White"
                    BorderColor="White"
                    HeightRequest="40"
                    IsEnabled="{Binding CanGoNext}"
                    Command="{Binding NextPageCommand}" />
        </Grid>

        <ActivityIndicator
            Grid.RowSpan="3"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            Color="{StaticResource PrimaryColor}"
            HorizontalOptions="Center"
            VerticalOptions="Center" />
    </Grid>
</ContentPage>
