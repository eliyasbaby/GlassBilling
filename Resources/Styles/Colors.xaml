<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Enterprise palette tuned for stronger contrast and readability -->
    <Color x:Key="PrimaryColor">#4338CA</Color>
    <Color x:Key="PrimaryDarkColor">#312E81</Color>
    <Color x:Key="PrimaryLightColor">#6366F1</Color>
    <Color x:Key="AccentColor">#2563EB</Color>
    <Color x:Key="SecondaryColor">#EEF2FF</Color>
    <Color x:Key="DangerColor">#D92D20</Color>
    <Color x:Key="SuccessColor">#15803D</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="BackgroundColor">#F3F6FB</Color>
    <Color x:Key="OnPrimaryColor">#FFFFFF</Color>
    <Color x:Key="TextPrimary">#1F2937</Color>
    <Color x:Key="TextSecondary">#475569</Color>
    <Color x:Key="BorderColor">#D7DFEA</Color>

    <!-- Gradient for backgrounds -->
    <Color x:Key="GradientStart">#6A1FCA</Color>
    <Color x:Key="GradientEnd">#3B47D4</Color>

    <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#DCEEFF" Offset="0" />
        <GradientStop Color="#FF063C77" Offset="0.5" />
        <GradientStop Color="#FF052A52" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
