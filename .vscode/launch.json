{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch MAUI Windows",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/bin/Debug/net8.0-windows10.0.19041.0/win10-x64/GlassBilling.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "preLaunchTask": "build-windows"
    },
    {
      "name": "Launch MAUI Android",
      "type": "coreclr",
      "request": "launch",
      "program": "dotnet",
      "args": ["run", "-f", "net8.0-android"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "preLaunchTask": "build-android"
    },
    {
      "name": "Launch MAUI Mac Catalyst",
      "type": "coreclr",
      "request": "launch",
      "program": "dotnet",
      "args": ["run", "-f", "net8.0-maccatalyst"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "preLaunchTask": "build-maccatalyst"
    }
  ]
}
